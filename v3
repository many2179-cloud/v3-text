-- Logic
local cached = {}

local function applyFilter(list)
	local q = searchBox.Text:lower()
	if q == "" then return list end
	local out = {}
	for _, entry in ipairs(list) do
		if entry.label:lower():find(q, 1, true) then
			table.insert(out, entry)
		end
	end
	return out
end

local function teleportToText(entry)
	local root = getRoot()
	if not root then
		status.Text = "No character found."
		return
	end
	if not entry.obj or not entry.obj:IsDescendantOf(workspace) then
		status.Text = "That text no longer exists. Hit Refresh."
		return
	end
	local pos = getTextPosition(entry.obj)
	if not pos then
		status.Text = "Couldn't get that text's position."
		return
	end

	local dist = (pos - root.Position).Magnitude
	root.CFrame = CFrame.new(pos + Vector3.new(0, HEIGHT_OFFSET, 0))
	status.Text = string.format("Teleported to \"%s\" (%.0f studs)", entry.label, dist)
end

local function render()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local shown = applyFilter(cached)
	for i, entry in ipairs(shown) do
		if i > MAX_ENTRIES then break end
		local btn = makeButton(
			string.format("%s  (%.0f studs)", entry.label, entry.dist),
			UDim2.new(1, 0, 0, 28),
			UDim2.new(),
			Color3.fromRGB(48, 48, 60),
			listFrame
		)
		btn.LayoutOrder = i
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.TextTruncate = Enum.TextTruncate.AtEnd
		btn.TextWrapped = false
		btn.MouseButton1Click:Connect(function()
			teleportToText(entry)
		end)
	end

	local note = #shown > MAX_ENTRIES and string.format(" (showing nearest %d)", MAX_ENTRIES) or ""
	status.Text = string.format("Found %d text(s)%s.", #shown, note)
end

local function refresh()
	cached = scanTexts()
	render()
end

nearestBtn.MouseButton1Click:Connect(function()
	for _, entry in ipairs(applyFilter(scanTexts())) do
		if entry.dist >= MIN_DISTANCE then
			teleportToText(entry)
			return
		end
	end
	status.Text = "No text found."
end)

farthestBtn.MouseButton1Click:Connect(function()
	local list = applyFilter(scanTexts())
	if #list == 0 then
		status.Text = "No text found."
		return
	end
	teleportToText(list[#list])
end)

refreshBtn.MouseButton1Click:Connect(refresh)
searchBox:GetPropertyChangedSignal("Text"):Connect(render)

-- Dragging
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

refresh()
